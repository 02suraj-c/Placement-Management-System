# ==============================================================================
# Placement Management System - Environment Configuration (.env.example)
# Copy this file to .env and replace placeholder values with your real credentials.
# ==============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# ── Database (MySQL / PostgreSQL) ─────────────────────────────────────────────
# MySQL Example:
DB_URL=jdbc:mysql://localhost:3306/placement_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password

# PostgreSQL Alternative:
# DB_URL=jdbc:postgresql://localhost:5432/placement_db
# DB_USERNAME=postgres
# DB_PASSWORD=your_secure_db_password

# ── JWT Authentication ────────────────────────────────────────────────────────
# Secret key must be at least 256 bits (32+ characters) long for HMAC-SHA256
JWT_SECRET=your-256-bit-long-random-secret-key-for-jwt-signing-minimum-32-chars
JWT_EXPIRATION_MS=86400000

# ── AI Provider Configuration ─────────────────────────────────────────────────
# Supported providers: openai, gemini, claude (via OpenAI-compatible wrapper)
AI_PROVIDER=openai
AI_API_KEY=sk-proj-yourOpenAiOrGeminiApiKeyHere
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1/chat/completions
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=3

# Gemini Alternative (using Google OpenAI compatibility endpoint):
# AI_PROVIDER=gemini
# AI_API_KEY=AIzaSyYourGeminiApiKeyHere
# AI_MODEL=gemini-1.5-flash
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# ── File Upload Limits ────────────────────────────────────────────────────────
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=10MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=10MB
