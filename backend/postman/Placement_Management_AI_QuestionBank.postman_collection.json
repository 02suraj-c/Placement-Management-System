		{
			"name": "2. Question Bank",
			"item": [
				{
					"name": "Get All Questions (Paginated & Filtered)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{studentToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/questions?page=0&size=10&company=Google&topic=Java&difficulty=MEDIUM",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"questions"
							],
							"query": [
								{
									"key": "page",
									"value": "0"
								},
								{
									"key": "size",
									"value": "10"
								},
								{
									"key": "company",
									"value": "Google"
								},
								{
									"key": "topic",
									"value": "Java"
								},
								{
									"key": "difficulty",
									"value": "MEDIUM"
								}
							]
						}
					}
				},
				{
					"name": "Get Question By ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{studentToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/questions/{{questionId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"questions",
								"{{questionId}}"
							]
						}
					}
				},
				{
					"name": "Create Question (Faculty / TPO)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var data = pm.response.json();",
									"    pm.collectionVariables.set('questionId', data.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{facultyToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"questionText\": \"Explain the internal working of HashMap in Java with collision handling.\",\n  \"answer\": \"HashMap uses an array of Node buckets. Hash collisions are resolved using linked lists, and converted to Red-Black Trees when treeify threshold (8) is exceeded.\",\n  \"company\": \"Amazon\",\n  \"topic\": \"Java, Collections\",\n  \"targetRole\": \"Software Development Engineer\",\n  \"difficulty\": \"MEDIUM\",\n  \"questionType\": \"TECHNICAL\",\n  \"tags\": \"java,hashmap,collections,dsa\",\n  \"yearAsked\": 2024\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/questions",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"questions"
							]
						}
					}
				},
				{
					"name": "Update Question (TPO / Faculty)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{tpoToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"questionText\": \"Explain the internal working of ConcurrentHashMap vs HashMap in Java.\",\n  \"answer\": \"ConcurrentHashMap uses lock striping with CAS and synchronized blocks on node buckets for concurrent safety without blocking entire map.\",\n  \"company\": \"Amazon\",\n  \"topic\": \"Java Concurrency\",\n  \"targetRole\": \"SDE-2\",\n  \"difficulty\": \"HARD\",\n  \"questionType\": \"TECHNICAL\",\n  \"tags\": \"java,concurrency,multithreading\",\n  \"yearAsked\": 2024\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/questions/{{questionId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"questions",
								"{{questionId}}"
							]
						}
					}
				},
				{
					"name": "Delete Question (TPO / Deputy TPO)",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{tpoToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/questions/{{questionId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"questions",
								"{{questionId}}"
							]
						}
					}
				}
			]
		},
